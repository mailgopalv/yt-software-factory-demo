diff --git a/api/routes/discounts.py b/api/routes/discounts.py
new file mode 100644
index 0000000..dc1e311
--- /dev/null
+++ b/api/routes/discounts.py
@@ -0,0 +1,47 @@
+from datetime import datetime, timezone
+
+from fastapi import APIRouter, Depends, HTTPException
+from sqlalchemy import select
+from sqlalchemy.orm import Session
+
+from api.deps import get_db, get_session_id
+from api.models import DiscountCode
+from api.routes.cart import get_or_create_cart, to_cart_out
+from api.schemas.discount import DiscountApply, DiscountOut
+
+router = APIRouter(prefix="/api/discounts", tags=["discounts"])
+
+
+def calculate_discount(db: Session, code: str, subtotal_cents: int) -> DiscountOut:
+    """Checks a code against a subtotal. Shared by /apply and order placement."""
+    normalised = code.strip().upper()
+    discount = db.scalar(select(DiscountCode).where(DiscountCode.code == normalised))
+    if discount is None:
+        raise HTTPException(status_code=400, detail="Discount code is invalid")
+    if discount.expires_at is not None and discount.expires_at < datetime.now(timezone.utc).replace(tzinfo=None):
+        raise HTTPException(status_code=400, detail="Discount code has expired")
+    if subtotal_cents < discount.min_subtotal_cents:
+        raise HTTPException(
+            status_code=400,
+            detail=f"Order total is below the ${discount.min_subtotal_cents / 100:.2f} minimum for this code",
+        )
+
+    discount_cents = (subtotal_cents * discount.percent_off + 50) // 100
+    return DiscountOut(
+        code=discount.code,
+        percent_off=discount.percent_off,
+        subtotal_cents=subtotal_cents,
+        discount_cents=discount_cents,
+        total_cents=subtotal_cents - discount_cents,
+    )
+
+
+@router.post("/apply", response_model=DiscountOut)
+def apply_discount(
+    body: DiscountApply, db: Session = Depends(get_db), session_id: str = Depends(get_session_id)
+):
+    """Previews a code against the shopper's cart. It changes nothing."""
+    cart = get_or_create_cart(db, session_id)
+    if not cart.items:
+        raise HTTPException(status_code=400, detail="Cart is empty")
+    return calculate_discount(db, body.code, to_cart_out(cart).total_cents)
