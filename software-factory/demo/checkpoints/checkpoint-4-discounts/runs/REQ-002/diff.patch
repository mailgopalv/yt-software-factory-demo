@@ -0,0 +1,110 @@
+import pytest
+from fastapi import HTTPException
+
+from api.routes.discounts import calculate_discount
+
+
+def test_apply_save10_returns_discount_and_total(client):
+    client.post("/api/cart", json={"product_id": 2, "quantity": 2})
+
+    response = client.post("/api/discounts/apply", json={"code": "SAVE10"})
+
+    assert response.status_code == 200
+    assert response.json() == {
+        "code": "SAVE10",
+        "percent_off": 10,
+        "subtotal_cents": 2998,
+        "discount_cents": 300,
+        "total_cents": 2698,
+    }
+
+
+@pytest.mark.parametrize("code", ["save10", "Save10", " Save10 "])
+def test_apply_code_is_case_insensitive(client, code):
+    client.post("/api/cart", json={"product_id": 2})
+
+    response = client.post("/api/discounts/apply", json={"code": code})
+
+    assert response.status_code == 200
+    assert response.json()["code"] == "SAVE10"
+
+
+def test_apply_welcome20_over_minimum_takes_20_percent(client):
+    client.post("/api/cart", json={"product_id": 3})
+
+    response = client.post("/api/discounts/apply", json={"code": "WELCOME20"})
+
+    assert response.status_code == 200
+    body = response.json()
+    assert body["discount_cents"] == 1200
+    assert body["total_cents"] == 5999 - 1200
+
+
+def test_apply_welcome20_under_minimum_returns_400(client):
+    client.post("/api/cart", json={"product_id": 2})
+
+    response = client.post("/api/discounts/apply", json={"code": "WELCOME20"})
+
+    assert response.status_code == 400
+    assert response.json()["detail"] == "Order total is below the $50.00 minimum for this code"
+
+
+def test_apply_expired_code_returns_400(client):
+    client.post("/api/cart", json={"product_id": 2})
+
+    response = client.post("/api/discounts/apply", json={"code": "SUMMER15"})
+
+    assert response.status_code == 400
+    assert response.json()["detail"] == "Discount code has expired"
+
+
+def test_apply_unknown_code_returns_400(client):
+    client.post("/api/cart", json={"product_id": 2})
+
+    response = client.post("/api/discounts/apply", json={"code": "BOGUS"})
+
+    assert response.status_code == 400
+    assert response.json()["detail"] == "Discount code is invalid"
+
+
+def test_apply_with_empty_cart_returns_400(client):
+    response = client.post("/api/discounts/apply", json={"code": "SAVE10"})
+
+    assert response.status_code == 400
+    assert response.json()["detail"] == "Cart is empty"
+
+
+@pytest.mark.parametrize("body", [{}, {"code": ""}, {"code": "X" * 33}])
+def test_apply_with_missing_or_bad_code_returns_422(client, body):
+    client.post("/api/cart", json={"product_id": 2})
+
+    response = client.post("/api/discounts/apply", json=body)
+
+    assert response.status_code == 422
+
+
+def test_apply_does_not_change_cart(client):
+    client.post("/api/cart", json={"product_id": 2})
+    before = client.get("/api/cart").json()
+
+    client.post("/api/discounts/apply", json={"code": "SAVE10"})
+
+    assert client.get("/api/cart").json() == before
+
+
+@pytest.mark.parametrize(
+    "subtotal, discount, total", [(3000, 300, 2700), (1999, 200, 1799)]
+)
+def test_calculate_discount_rounds_to_nearest_cent(db, subtotal, discount, total):
+    with db() as session:
+        result = calculate_discount(session, "save10", subtotal)
+
+    assert result.discount_cents == discount
+    assert result.total_cents == total
+
+
+def test_calculate_discount_checks_expiry_before_minimum(db):
+    with db() as session, pytest.raises(HTTPException) as exc:
+        calculate_discount(session, "SUMMER15", 0)
+
+    assert exc.value.detail == "Discount code has expired"
