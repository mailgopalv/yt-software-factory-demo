diff --git a/e2e/tests/discount.spec.js b/e2e/tests/discount.spec.js
new file mode 100644
index 0000000..3966dd6
--- /dev/null
+++ b/e2e/tests/discount.spec.js
@@ -0,0 +1,52 @@
+// Each test runs in a fresh browser context, so it gets its own session id and an empty cart.
+const { test, expect } = require('@playwright/test');
+
+test('a shopper can apply a discount code at checkout', async ({ page }) => {
+  // Ceramic Coffee Mug ($14.99) + Dotted Notebook ($9.99) = $24.98
+  await page.goto('/products/2');
+  await page.getByRole('button', { name: 'Add to cart' }).click();
+  await expect(page.getByTestId('cart-count')).toHaveText('1');
+  await page.goto('/products/5');
+  await page.getByRole('button', { name: 'Add to cart' }).click();
+  await expect(page.getByTestId('cart-count')).toHaveText('2');
+
+  await page.goto('/checkout');
+  await expect(page.getByTestId('checkout-subtotal')).toHaveText('$24.98');
+  await expect(page.getByTestId('checkout-total')).toHaveText('$24.98');
+
+  const input = page.getByTestId('discount-code-input');
+  const apply = page.getByTestId('discount-apply');
+
+  await input.fill('BOGUS');
+  await apply.click();
+  await expect(page.getByTestId('discount-error')).toHaveText('Discount code is invalid');
+  await expect(page.getByTestId('checkout-total')).toHaveText('$24.98');
+
+  await input.fill('SUMMER15');
+  await apply.click();
+  await expect(page.getByTestId('discount-error')).toHaveText('Discount code has expired');
+  await expect(page.getByTestId('checkout-total')).toHaveText('$24.98');
+
+  await input.fill('WELCOME20');
+  await apply.click();
+  await expect(page.getByTestId('discount-error')).toHaveText(
+    'Order total is below the $50.00 minimum for this code',
+  );
+  await expect(page.getByTestId('checkout-total')).toHaveText('$24.98');
+
+  // 10% of $24.98 is $2.498, which rounds to $2.50
+  await input.fill('save10');
+  await apply.click();
+  await expect(page.getByTestId('discount-error')).toHaveCount(0);
+  await expect(page.getByTestId('discount-amount')).toHaveText('-$2.50');
+  await expect(page.getByTestId('checkout-total')).toHaveText('$22.48');
+
+  await page.getByLabel('Name').fill('Ada Lovelace');
+  await page.getByLabel('Email').fill('ada@example.com');
+  await page.getByLabel('Address').fill('12 Analytical Way, London');
+  await page.getByRole('button', { name: 'Place order' }).click();
+
+  await expect(page.getByRole('heading', { name: 'Thank you, Ada Lovelace!' })).toBeVisible();
+  await expect(page.getByTestId('order-total')).toHaveText('$22.48');
+  await expect(page.getByTestId('cart-count')).toHaveText('0');
+});
