diff --git a/api/tests/test_acceptance_discount_codes.py b/api/tests/test_acceptance_discount_codes.py
new file mode 100644
index 0000000..b62e4ea
--- /dev/null
+++ b/api/tests/test_acceptance_discount_codes.py
@@ -0,0 +1,191 @@
+"""Acceptance tests for REQ-002 Discount Codes, written from the criteria and API contract."""
+from api.models import Order, Product
+
+HEADPHONES = 1  # Wireless Headphones, 7999 cents, stock 25
+MUG = 2  # Ceramic Coffee Mug, 1499 cents
+NOTEBOOK = 5  # Dotted Notebook, 999 cents
+
+CHECKOUT = {"customer_name": "Ada Shopper", "email": "ada@example.com", "address": "1 High Street"}
+
+
+def set_price(db, product_id, price_cents):
+    """Seed prices all end in 99, so exact cart totals like $30.00 need a repriced product."""
+    with db() as session:
+        session.get(Product, product_id).price_cents = price_cents
+        session.commit()
+
+
+def apply(client, code, **kwargs):
+    return client.post("/api/discounts/apply", json={"code": code}, **kwargs)
+
+
+def cart_total(client):
+    return client.get("/api/cart").json()["total_cents"]
+
+
+def test_save10_on_a_30_dollar_cart_gives_3_dollars_off_and_27_dollar_total(client, db):
+    set_price(db, MUG, 3000)
+    client.post("/api/cart", json={"product_id": MUG, "quantity": 1})
+
+    response = apply(client, "SAVE10")
+
+    assert response.status_code == 200
+    assert response.json() == {"code": "SAVE10", "percent_off": 10, "subtotal_cents": 3000,
+                               "discount_cents": 300, "total_cents": 2700}
+
+
+def test_code_is_accepted_in_any_letter_case(client):
+    client.post("/api/cart", json={"product_id": MUG, "quantity": 2})
+    expected = apply(client, "SAVE10").json()
+
+    for code in ("save10", "Save10", "  save10  "):
+        response = apply(client, code)
+        assert response.status_code == 200, code
+        assert response.json() == expected
+
+
+def test_welcome20_on_a_cart_of_50_dollars_or_more_takes_20_percent_off(client):
+    client.post("/api/cart", json={"product_id": HEADPHONES, "quantity": 1})  # 7999
+
+    response = apply(client, "WELCOME20")
+
+    assert response.status_code == 200
+    assert response.json() == {"code": "WELCOME20", "percent_off": 20, "subtotal_cents": 7999,
+                               "discount_cents": 1600, "total_cents": 6399}
+
+
+def test_welcome20_on_a_cart_of_exactly_50_dollars_is_accepted(client, db):
+    set_price(db, MUG, 5000)
+    client.post("/api/cart", json={"product_id": MUG, "quantity": 1})
+
+    response = apply(client, "WELCOME20")
+
+    assert response.status_code == 200
+    assert response.json()["discount_cents"] == 1000
+    assert response.json()["total_cents"] == 4000
+
+
+def test_welcome20_below_50_dollars_shows_minimum_error_and_total_unchanged(client, db):
+    set_price(db, MUG, 4999)
+    client.post("/api/cart", json={"product_id": MUG, "quantity": 1})
+
+    response = apply(client, "WELCOME20")
+
+    assert response.status_code == 400
+    assert response.json() == {"detail": "Order total is below the $50.00 minimum for this code"}
+    assert cart_total(client) == 4999
+
+
+def test_summer15_shows_expired_error_and_total_unchanged(client):
+    client.post("/api/cart", json={"product_id": HEADPHONES, "quantity": 1})
+
+    response = apply(client, "SUMMER15")
+
+    assert response.status_code == 400
+    assert response.json() == {"detail": "Discount code has expired"}
+    assert cart_total(client) == 7999
+
+
+def test_unknown_code_shows_invalid_error_and_total_unchanged(client):
+    client.post("/api/cart", json={"product_id": MUG, "quantity": 1})
+
+    response = apply(client, "BOGUS")
+
+    assert response.status_code == 400
+    assert response.json() == {"detail": "Discount code is invalid"}
+    assert cart_total(client) == 1499
+
+
+def test_save10_on_a_19_99_cart_rounds_discount_to_2_dollars_and_total_17_99(client, db):
+    set_price(db, MUG, 1999)
+    client.post("/api/cart", json={"product_id": MUG, "quantity": 1})
+
+    response = apply(client, "save10")
+
+    assert response.status_code == 200
+    assert response.json() == {"code": "SAVE10", "percent_off": 10, "subtotal_cents": 1999,
+                               "discount_cents": 200, "total_cents": 1799}
+
+
+def test_placed_order_with_valid_code_shows_and_stores_discounted_total(client, db):
+    set_price(db, MUG, 3000)
+    client.post("/api/cart", json={"product_id": MUG, "quantity": 1})
+
+    response = client.post("/api/orders", json={**CHECKOUT, "discount_code": "save10"})
+
+    assert response.status_code == 201
+    order = response.json()
+    assert order["total_cents"] == 2700
+    assert order["discount_code"] == "SAVE10"
+    assert order["discount_cents"] == 300
+    with db() as session:
+        stored = session.get(Order, order["id"])
+        assert (stored.total_cents, stored.discount_code, stored.discount_cents) == (2700, "SAVE10", 300)
+
+
+def test_order_without_code_is_placed_at_full_price(client):
+    for extra in ({}, {"discount_code": None}, {"discount_code": "   "}):
+        client.post("/api/cart", json={"product_id": MUG, "quantity": 2})
+        response = client.post("/api/orders", json={**CHECKOUT, **extra})
+        assert response.status_code == 201, extra
+        assert response.json()["total_cents"] == 2998
+        assert response.json()["discount_code"] is None
+        assert response.json()["discount_cents"] == 0
+
+
+def test_order_with_bad_code_is_rejected_and_cart_and_stock_unchanged(client):
+    client.post("/api/cart", json={"product_id": HEADPHONES, "quantity": 2})
+
+    for code, detail in (("BOGUS", "Discount code is invalid"),
+                         ("SUMMER15", "Discount code has expired")):
+        response = client.post("/api/orders", json={**CHECKOUT, "discount_code": code})
+        assert response.status_code == 400
+        assert response.json() == {"detail": detail}
+
+    assert cart_total(client) == 15998
+    assert client.get(f"/api/products/{HEADPHONES}").json()["stock"] == 25
+
+
+def test_order_below_code_minimum_is_rejected(client):
+    client.post("/api/cart", json={"product_id": MUG, "quantity": 1})
+
+    response = client.post("/api/orders", json={**CHECKOUT, "discount_code": "WELCOME20"})
+
+    assert response.status_code == 400
+    assert response.json() == {"detail": "Order total is below the $50.00 minimum for this code"}
+    assert cart_total(client) == 1499
+
+
+def test_applying_a_code_changes_nothing(client):
+    client.post("/api/cart", json={"product_id": MUG, "quantity": 1})
+
+    apply(client, "SAVE10")
+
+    assert cart_total(client) == 1499
+    assert client.get(f"/api/products/{MUG}").json()["stock"] == 60
+
+
+def test_applying_a_code_to_an_empty_cart_returns_400(client):
+    response = apply(client, "SAVE10")
+
+    assert response.status_code == 400
+    assert response.json() == {"detail": "Cart is empty"}
+
+
+def test_applying_uses_only_the_current_shoppers_cart(client):
+    client.post("/api/cart", json={"product_id": HEADPHONES, "quantity": 1})
+    other = {"X-Session-Id": "another-shopper"}
+    client.post("/api/cart", json={"product_id": NOTEBOOK, "quantity": 1}, headers=other)
+
+    assert apply(client, "SAVE10").json()["subtotal_cents"] == 7999
+    assert apply(client, "SAVE10", headers=other).json()["subtotal_cents"] == 999
+    assert apply(client, "WELCOME20", headers=other).status_code == 400
+
+
+def test_missing_empty_or_too_long_code_returns_422(client):
+    client.post("/api/cart", json={"product_id": MUG, "quantity": 1})
+
+    assert client.post("/api/discounts/apply", json={}).status_code == 422
+    assert apply(client, "").status_code == 422
+    assert apply(client, "X" * 33).status_code == 422
+    assert client.post("/api/orders", json={**CHECKOUT, "discount_code": "X" * 33}).status_code == 422
