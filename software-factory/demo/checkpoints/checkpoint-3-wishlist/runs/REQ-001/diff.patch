--- /dev/null
+++ b/frontend/src/components/HeartButton.jsx
@@ -0,0 +1,25 @@
+import { useWishlist } from '../WishlistContext';
+
+export default function HeartButton({ productId, name }) {
+  const { isSaved, toggle } = useWishlist();
+  const saved = isSaved(productId);
+
+  const handleClick = (e) => {
+    e.preventDefault();
+    e.stopPropagation();
+    toggle(productId).catch(() => {});
+  };
+
+  return (
+    <button
+      type="button"
+      className={`heart-button${saved ? ' saved' : ''}`}
+      aria-pressed={saved}
+      aria-label={saved ? `Remove ${name} from wishlist` : `Save ${name} to wishlist`}
+      data-testid="heart-button"
+      onClick={handleClick}
+    >
+      {saved ? '♥' : '♡'}
+    </button>
+  );
+}
