@@ -0,0 +1,52 @@
+import { screen } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { describe, expect, it, vi } from 'vitest';
+import * as api from '../api';
+import Wishlist from '../pages/Wishlist';
+import { EMPTY_CART, EMPTY_WISHLIST, renderPage } from '../test/renderPage';
+
+vi.mock('../api');
+
+const WISHLIST_WITH_ITEMS = {
+  items: [
+    { product_id: 1, name: 'Wireless Headphones', image: '🎧', price_cents: 7999 },
+    { product_id: 2, name: 'Ceramic Coffee Mug', image: '☕', price_cents: 1499 },
+  ],
+  item_count: 2,
+};
+
+describe('Wishlist page', () => {
+  it('shows a message and a link to the products when the wishlist is empty', async () => {
+    api.getCart.mockResolvedValue(EMPTY_CART);
+    api.getWishlist.mockResolvedValue(EMPTY_WISHLIST);
+
+    renderPage(<Wishlist />, { route: '/wishlist', path: '/wishlist' });
+
+    expect(await screen.findByText('Your wishlist is empty.')).toBeInTheDocument();
+    expect(screen.getByRole('link', { name: 'Browse products' })).toHaveAttribute('href', '/');
+  });
+
+  it('lists saved products with name, image, price and a link to the product', async () => {
+    api.getCart.mockResolvedValue(EMPTY_CART);
+    api.getWishlist.mockResolvedValue(WISHLIST_WITH_ITEMS);
+
+    renderPage(<Wishlist />, { route: '/wishlist', path: '/wishlist' });
+
+    expect(await screen.findAllByTestId('wishlist-item')).toHaveLength(2);
+    expect(screen.getByRole('link', { name: 'Wireless Headphones' })).toHaveAttribute('href', '/products/1');
+    expect(screen.getByText('🎧')).toBeInTheDocument();
+    expect(screen.getByText('$79.99')).toBeInTheDocument();
+  });
+
+  it('removes a product', async () => {
+    api.getCart.mockResolvedValue(EMPTY_CART);
+    api.getWishlist.mockResolvedValue(WISHLIST_WITH_ITEMS);
+    api.removeFromWishlist.mockResolvedValue({ items: [WISHLIST_WITH_ITEMS.items[1]], item_count: 1 });
+
+    renderPage(<Wishlist />, { route: '/wishlist', path: '/wishlist' });
+    await userEvent.click(await screen.findByRole('button', { name: 'Remove Wireless Headphones from wishlist' }));
+
+    expect(api.removeFromWishlist).toHaveBeenCalledWith(1);
+    expect(await screen.findAllByTestId('wishlist-item')).toHaveLength(1);
+  });
+});
