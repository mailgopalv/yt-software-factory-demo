--- /dev/null
+++ b/frontend/src/pages/Wishlist.jsx
@@ -0,0 +1,43 @@
+import { Link } from 'react-router-dom';
+import { useWishlist } from '../WishlistContext';
+import { formatPrice } from '../money';
+
+export default function Wishlist() {
+  const { wishlist, removeItem } = useWishlist();
+
+  if (wishlist.items.length === 0) {
+    return (
+      <section>
+        <h1>Wishlist</h1>
+        <p>Your wishlist is empty.</p>
+        <Link to="/" className="button">
+          Browse products
+        </Link>
+      </section>
+    );
+  }
+
+  return (
+    <section>
+      <h1>Wishlist</h1>
+      <div className="card wishlist-list">
+        {wishlist.items.map((item) => (
+          <div className="wishlist-row" key={item.product_id} data-testid="wishlist-item">
+            <span className="product-image small">{item.image}</span>
+            <Link to={`/products/${item.product_id}`} className="wishlist-name">
+              {item.name}
+            </Link>
+            <span className="price">{formatPrice(item.price_cents)}</span>
+            <button
+              className="button link"
+              onClick={() => removeItem(item.product_id).catch(() => {})}
+              aria-label={`Remove ${item.name} from wishlist`}
+            >
+              Remove
+            </button>
+          </div>
+        ))}
+      </div>
+    </section>
+  );
+}
